<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>ai.smart-agents.weekly</string>
<key>ProgramArguments</key><array><string>/ABSOLUTE/PATH/smart-agents/deploy/weekly-launcher.sh</string></array>
<key>EnvironmentVariables</key><dict><key>SMART_AGENTS_ENV_FILE</key><string>/PRIVATE/PATH/smart-agents.env</string></dict>
<key>RunAtLoad</key><false/>
<key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
<key>StandardOutPath</key><string>/PRIVATE/PATH/weekly.stdout.log</string>
<key>StandardErrorPath</key><string>/PRIVATE/PATH/weekly.stderr.log</string>
<key>LowPriorityIO</key><true/>
</dict></plist>
