# Synthetic local development only. Use separate restricted credentials elsewhere.
RDS_URL=postgresql://postgres:synthetic-test-only@127.0.0.1:55439/smart_agents
SMART_AGENTS_TEST_DSN=postgresql://postgres:synthetic-test-only@127.0.0.1:55439/smart_agents
CORPUS_URL=http://127.0.0.1:8210
# Set privately before enabling trusted administrative writes.
CORPUS_ADMIN_TOKEN=
# No local generative fallback. Choose an authenticated, approved cloud classifier explicitly.
LEARNING_CLASSIFIER_BACKEND=disabled
# Tool-less compatible endpoint/model/key, or installed JEV adapter, configured privately.
OLLAMA_HOST=http://127.0.0.1:11434
LEARNING_CORPUS_EMBED_MODEL=nomic-embed-text
RERANK_ENABLED=0
# Set to a downloaded local model directory after installing the rerank extra.
RERANK_MODEL=
RERANK_MIN_SCORE=-8.0
RERANK_POOL=12
RERANK_BUDGET_S=1.5
RERANK_THREADS=2
RERANK_DEDUPE_COS=0.90
SMART_AGENTS_ORG=cross
SMART_AGENTS_INSTANCE=development
# Supply private absolute locations if enabling capture and weekly training.
# SMART_AGENTS_STATE_DIR=/private/state/smart-agents
# SMART_AGENTS_TRIPLES=/private/data/triples.jsonl
CMEM_PRO_TOKEN=
